{
    "name": "@party-stack/icon-lab",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsc --noEmit",
        "dev": "vite dev",
        "dist": "vite build",
        "lint": "eslint",
        "test": "vitest run src",
        "icons:extract": "tsx scripts/extract-assets.ts",
        "icons:embed": "tsx scripts/generate-embeddings.ts",
        "icons:prepare": "pnpm icons:extract && pnpm icons:embed"
    },
    "dependencies": {
        "@party-stack/icons": "workspace:*",
        "@party-stack/icons-blueprint": "workspace:*",
        "@party-stack/icons-expo": "workspace:*",
        "@party-stack/icons-lucide": "workspace:*",
        "react": "^19.2.0",
        "react-dom": "^19.2.0"
    },
    "devDependencies": {
        "@blueprintjs/icons": "^6.13.0",
        "@iconify-json/material-symbols": "^1.2.88",
        "@lucide/icons": "^1.31.0",
        "@resvg/resvg-js": "^2.6.2",
        "@salesforce-ux/icons": "^10.17.0",
        "@tailwindcss/vite": "^4",
        "@types/node": "^24.10.1",
        "@types/react": "^19.2.6",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^4.7.0",
        "@xenova/transformers": "^2.17.2",
        "eslint": "^9.25.0",
        "sharp": "^0.34.2",
        "tailwindcss": "^4.0.6",
        "tsx": "^4.20.3",
        "typescript": "~5.8.3",
        "vite": "^7.2.4",
        "vitest": "^3.1.1"
    }
}
